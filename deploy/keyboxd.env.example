# /etc/keybox/keyboxd.env
# Brug vault-serverens Tailscale-adresse (tailscale ip -4), aldrig 0.0.0.0.
KEYBOX_AGENT_LISTEN=100.64.0.1:8443
# Port 8444, fordi Vaultwarden typisk bruger 443, og Key-Box kører uden
# rettighed til porte under 1024.
KEYBOX_WEB_LISTEN=100.64.0.1:8444
# Serverens fulde Tailscale-navn og samme port. Passkeys bindes til navnet.
KEYBOX_ORIGIN=https://vault.example.ts.net:8444
# Agenter afvises, indtil så mange passkeys er registreret. 2 betyder, at der
# altid er en reserve. Sæt kun til 1, hvis du accepterer at køre uden.
KEYBOX_MIN_PASSKEYS=2
# Hvor policy-forslagene læses fra. Med keybox-policy-sync er det en kopi af
# Git-repoet; uden er det en mappe, du selv lægger filer i.
KEYBOX_POLICY_DIR=/var/lib/keybox-policy/policy
# Hvem der overhovedet må forbinde, som Tailscale-adresser adskilt af komma.
# Agent-porten: agentmaskinen. Siden: Christians telefon (og evt. en reserve).
# Tomt er en fejl; der findes ingen måde at skrive "alle" på.
KEYBOX_AGENT_ALLOW=100.64.0.10
KEYBOX_WEB_ALLOW=100.64.0.20
