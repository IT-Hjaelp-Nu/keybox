[Unit]
Description=Hent Key-Box' policy-forslag fra Git
Documentation=https://github.com/IT-Hjaelp-Nu/Key-Box
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Its own user: it can read one repository and write one directory. It is not
# in Key-Box' group and cannot read Key-Box' keys, state or settings.
User=keybox-policy
Group=keybox-policy
# Group "keybox" owns the directory (setgid), so Key-Box can read what lands there.
UMask=0027
Environment=GIT_SSH_COMMAND="ssh -i /var/lib/keybox-policy/.ssh/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/lib/keybox-policy/.ssh/known_hosts -o ConnectTimeout=15"
# The directory always mirrors main. What is in it is only a proposal:
# Key-Box uses nothing from it before Christian approves with a passkey.
ExecStart=/usr/bin/git -C /var/lib/keybox-policy/policy fetch --quiet --prune origin main
ExecStart=/usr/bin/git -C /var/lib/keybox-policy/policy reset --quiet --hard origin/main
TimeoutStartSec=60

ReadWritePaths=/var/lib/keybox-policy/policy
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
